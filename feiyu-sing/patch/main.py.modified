import asyncio
import json
import os
import re
import subprocess
import time
from pathlib import Path

import astrbot.api.message_components as Comp
from astrbot.api import AstrBotConfig, logger
from astrbot.api.event import AstrMessageEvent, MessageChain, filter
from astrbot.api.star import Context, Star, StarTools, register
from astrbot.core.star.filter.command import GreedyStr

from .client import VoiceClient


@register("feiyu_voice", "kaiyuey03", "肥鱼说话、换声与按谱唱歌统一接口", "0.1.0")
class FeiyuVoice(Star):
    def __init__(self, context: Context, config: AstrBotConfig):
        super().__init__(context)
        self.config = config
        self.client = VoiceClient(
            config.get("base_url", "http://127.0.0.1:9880"), config.get("api_key", "")
        )
        self.directory = StarTools.get_data_dir("feiyu_voice")
        self.pending_songs = {}
        self.state_path = self.directory / "jobs.json"
        self.jobs = (
            json.loads(self.state_path.read_text(encoding="utf-8"))
            if self.state_path.exists()
            else {}
        )
        self.tasks = set()

    async def initialize(self):
        for job_id, row in self.jobs.items():
            if row.get("pending"):
                self.watch(job_id, row["origin"])

    def persist(self):
        temporary = self.state_path.with_suffix(".tmp")
        temporary.write_text(
            json.dumps(self.jobs, ensure_ascii=False, indent=2), encoding="utf-8"
        )
        temporary.replace(self.state_path)

    def watch(self, job_id, origin):
        task = asyncio.create_task(self.deliver(job_id, origin))
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    # ── 整首歌翻唱：搜歌 → 分离 → 换声 → 混音 ──────────────
    SING_SCRIPT = r"D:\shipinmoxing\feiyu_src\sing_song_win.py"
    SING_PY = r"D:\ComfyUI-aki-v2.7z\ComfyUI-aki-v2\python\python.exe"
    SERVICE_BAT = r"D:\大肥鱼随心所欲\_feiyu_voice\start_voice.bat"

    def ensure_service(self):
        """服务离线就自己拉起来（开机自启不可靠时的兜底）"""
        import urllib.request
        try:
            req = urllib.request.Request(
                "http://127.0.0.1:9880/v1/capabilities",
                headers={"Authorization": "Bearer " + str(self.config.get("api_key", ""))},
            )
            urllib.request.urlopen(req, timeout=4)
            return True
        except Exception:
            logger.warning("声音服务不在，尝试自动启动")
            try:
                subprocess.Popen(
                    ["cmd.exe", "/c", self.SERVICE_BAT],
                    creationflags=0x08000000,  # CREATE_NO_WINDOW
                    close_fds=True,
                )
            except Exception:
                logger.exception("自动启动声音服务失败")
                return False
            for _ in range(30):
                time.sleep(2)
                try:
                    req = urllib.request.Request(
                        "http://127.0.0.1:9880/v1/capabilities",
                        headers={"Authorization": "Bearer " + str(self.config.get("api_key", ""))},
                    )
                    urllib.request.urlopen(req, timeout=4)
                    logger.info("声音服务已自动启动")
                    return True
                except Exception:
                    continue
            return False

    # ── 点歌：先确认，确认了才唱 ────────────────────────
    CONFIRM_WORDS = ("是", "对", "嗯", "好", "唱", "没错", "就这个", "就是它", "可以", "行", "唱吧", "就这首")
    DENY_WORDS = ("不是", "不对", "错了", "换", "算了", "不要", "no", "取消")

    def ask_confirm(self, event, song):
        task = asyncio.create_task(self._preview_and_ask(event, song))
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    async def _preview_and_ask(self, event, song):
        origin = event.unified_msg_origin
        try:
            proc = await asyncio.create_subprocess_exec(
                self.SING_PY, self.SING_SCRIPT, song, "--preview",
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.DEVNULL,
            )
            out, _ = await proc.communicate()
            text = (out or b"").decode("utf-8", "replace")
            try:
                with open(r"D:\DafeiyuQQ\_logs\sing_debug.log", "a", encoding="utf-8") as fh:
                    fh.write(f"\n===== [preview] {song} rc={proc.returncode} =====\n{text[-2000:]}\n")
            except Exception:
                pass
            line = next((l for l in text.splitlines() if l.startswith("PREVIEW ")), None)
            if not line:
                await self.context.send_message(
                    origin, MessageChain([Comp.Plain("这首歌我没找到原曲…换个名字试试？")]))
                return
            meta = json.loads(line[len("PREVIEW "):])
            self.pending_songs[origin] = dict(song=song, meta=meta, ts=time.time())
            title = (meta.get("title") or song).strip()
            lyric = (meta.get("lyric") or "").strip()
            dur = (meta.get("duration") or "").strip()
            cached = meta.get("cached")

            if cached:
                msg = f"《{title}》我之前唱过，直接发给你？回「是」我就发"
            else:
                head = f"找到的是这首：\n{title}"
                if dur:
                    head += f"\n（{dur}）"
                msg = head
                if lyric:
                    msg += f"\n\n歌词：「{lyric}」"
                msg += "\n\n是这首吗？回「是」我就唱"
            await self.context.send_message(origin, MessageChain([Comp.Plain(msg)]))
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            logger.error(f"preview failed: {exc}")
            try:
                await self.context.send_message(
                    origin, MessageChain([Comp.Plain("我这边有点懵，再说一遍歌名好不好")]))
            except Exception:
                pass

    def sing(self, event, song):
        task = asyncio.create_task(self.deliver_song(event, song))
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    async def deliver_song(self, event, song):
        origin = event.unified_msg_origin
        try:
            self.ensure_service()
            proc = await asyncio.create_subprocess_exec(
                self.SING_PY, self.SING_SCRIPT, song,
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT,
            )
            out, _ = await proc.communicate()
            text = (out or b"").decode("utf-8", "replace")
            try:
                with open(r"D:\DafeiyuQQ\_logs\sing_debug.log", "a", encoding="utf-8") as fh:
                    fh.write(f"\n===== {song} rc={proc.returncode} =====\n{text[-4000:]}\n")
            except Exception:
                pass
            logger.info("sing output tail: " + text[-800:])
            line = next((l for l in text.splitlines() if l.startswith("RESULT ")), None)
            if not line:
                raise RuntimeError("no RESULT line")
            mp3 = line.split("|")[0].replace("RESULT ", "").strip()
            if not os.path.exists(mp3):
                raise RuntimeError("output missing")
            pieces = self.split_audio(mp3, 58)
            for piece in pieces:
                await self.context.send_message(
                    origin,
                    MessageChain([Comp.Record.fromFileSystem(piece)]),
                )
                await asyncio.sleep(1.5)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            logger.error(f"sing failed: {exc}")
            try:
                await self.context.send_message(
                    origin,
                    MessageChain([Comp.Plain("呜…这首歌我唱砸了，换一首好不好 qwq")]),
                )
            except Exception:
                logger.exception("sing failure notice could not be delivered")

    def audio_seconds(self, path):
        """用 ffprobe 拿音频时长"""
        ffprobe = r"D:\shipinmoxing\bin\ffprobe.exe"
        try:
            r = subprocess.run(
                [ffprobe, "-v", "error", "-show_entries", "format=duration",
                 "-of", "csv=p=0", path],
                capture_output=True, timeout=30,
            )
            return float((r.stdout or b"0").decode().strip() or 0)
        except Exception:
            return 0.0

    def split_audio(self, mp3, seconds):
        """把长音频切成若干段，规避 QQ 语音时长限制（重编码，切点准确）"""
        outdir = os.path.join(os.path.dirname(mp3), "parts")
        if os.path.isdir(outdir):
            for f in os.listdir(outdir):
                if f.endswith(".mp3"):
                    os.remove(os.path.join(outdir, f))
        else:
            os.makedirs(outdir, exist_ok=True)
        ffmpeg = r"D:\shipinmoxing\bin\ffmpeg.exe"
        pattern = os.path.join(outdir, "part_%03d.mp3")
        try:
            subprocess.run(
                [ffmpeg, "-y", "-i", mp3, "-f", "segment",
                 "-segment_time", str(seconds), "-reset_timestamps", "1",
                 "-c:a", "libmp3lame", "-qscale:a", "4", pattern],
                capture_output=True, timeout=600,
            )
        except Exception as exc:
            logger.error(f"split failed: {exc}")
            return [mp3]
        pieces = sorted(
            os.path.join(outdir, f) for f in os.listdir(outdir) if f.endswith(".mp3")
        )
        # 尾段太短（<20 秒）就并在前一段里，不然会出现几秒的小尾巴
        if len(pieces) >= 2 and self.audio_seconds(pieces[-1]) < 20:
            tail = pieces.pop()
            prev = pieces.pop()
            joined = os.path.join(outdir, "part_joined.mp3")
            lst = os.path.join(outdir, "concat.txt")
            with open(lst, "w", encoding="utf-8") as f:
                for p in (prev, tail):
                    f.write(f"file '{p.replace(chr(92), '/')}'\n")
            r = subprocess.run(
                [ffmpeg, "-y", "-f", "concat", "-safe", "0", "-i", lst,
                 "-c:a", "libmp3lame", "-qscale:a", "4", joined],
                capture_output=True, timeout=600,
            )
            if r.returncode == 0 and os.path.exists(joined):
                pieces.append(joined)
            else:
                pieces.extend([prev, tail])
        merged = pieces
        return merged or [mp3]

    async def deliver(self, job_id, origin):
        try:
            self.ensure_service()
            await self.client.wait(job_id)
            audio = await self.client.download(job_id, self.directory)
            chain = MessageChain(
                [Comp.Record.fromFileSystem(str(audio))]
            )
            sent = await self.context.send_message(origin, chain)
            if not sent:
                raise RuntimeError(
                    "The platform could not deliver the audio; retrieve it using the job command"
                )
            self.jobs[job_id]["pending"] = False
            self.jobs[job_id]["delivered"] = True
            self.persist()
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            logger.error(f"Feiyu voice delivery failed: {exc}")
            self.jobs[job_id]["pending"] = False
            self.persist()
            try:
                await self.context.send_message(
                    origin,
                    MessageChain([Comp.Plain(self._oops(exc))]),
                )
            except Exception:
                logger.exception("Feiyu failure notification could not be delivered")

    async def enqueue(self, event, kind, payload):
        if not self.config.get("api_key"):
            raise ValueError("请先在插件配置中填写声音服务 API Key。")
        payload["voice"] = self.config.get("voice", "feiyu")
        row = await self.client.submit(kind, payload)
        origin = event.unified_msg_origin
        self.jobs[row["id"]] = dict(origin=origin, pending=True)
        self.persist()
        self.watch(row["id"], origin)
        return "等我清清嗓子，马上就好～"

    async def attached_asset(self, event, suffixes):
        components = list(event.get_messages())
        for component in list(components):
            if isinstance(component, Comp.Reply) and isinstance(
                getattr(component, "chain", None), list
            ):
                components.extend(component.chain)
        for component in components:
            if isinstance(component, Comp.Record) and ".wav" in suffixes:
                path = await component.convert_to_file_path()
                return await self.client.upload(path, "vocal.wav")
            if isinstance(component, Comp.File):
                name = component.name or ""
                if Path(name).suffix.lower() in suffixes:
                    path = await component.get_file()
                    return await self.client.upload(path, name)
        raise ValueError("请在本条消息中附上所需音频或 MIDI／ABC 文件。")

    def _oops(self, exc) -> str:
        """把技术错误翻译成她自己的口吻。"""
        text = str(exc) or ""
        low = text.lower()
        if "memory" in low or "out of memory" in low:
            return "呜…脑子有点转不动了，让我缓一缓好不好"
        if "string_too_short" in low or "422" in text:
            return "你还没说想让我说什么呀"
        if "not configured" in low or "svs" in low:
            return "唱歌我还没学会呢…等我练练嗓子再唱给你听嘛"
        if "connect" in low or "refused" in low or "timeout" in low or "http" in low:
            return "等我清清嗓子，一会儿再给你说"
        return "哎呀，刚刚卡了一下下，再试一次嘛"

    @filter.command("肥鱼状态", alias={"feiyu_status"})
    async def capabilities(self, event: AstrMessageEvent):
        try:
            data = (await self.client.request("GET", "/v1/capabilities")).json()
            tts = any(row["available"] for row in data["tts"])
            rvc = any(row["available"] for row in data["rvc"])
            yield event.plain_result(
                f"肥鱼服务：说话 {'可用' if tts else '未安装'}；换声 {'可用' if rvc else '未安装'}；按谱唱歌 {'可用' if data['singing']['available'] else '未安装'}。"
            )
        except Exception as exc:
            yield event.plain_result(self._oops(exc))

    @filter.command("肥鱼说话", alias={"feiyu_tts"})
    async def speech(self, event: AstrMessageEvent, text: GreedyStr):
        try:
            content = str(text).strip()
            if not content:
                yield event.plain_result("想让我说什么呀")
                return
            yield event.plain_result(
                await self.enqueue(
                    event,
                    "speech",
                    dict(text=content, style=self.config.get("style", "gentle")),
                )
            )
        except Exception as exc:
            yield event.plain_result(self._oops(exc))

    # ── 自然语言（不用斜杠）──────────────────────────────
    NATURAL_SPEAK = re.compile(
        r"^(?:大肥鱼|肥鱼)\s*[，,、]?\s*(?:说|讲|念|读)话?\s*[：:]?\s*(.+)$"
    )
    NATURAL_SING = re.compile(r"^(?:给我|帮(?:我)?)?\s*(?:唱|来)\s*(?:一?首|一个|个)?\s*(.+)$")
    NATURAL_BIGSING = re.compile(
        r"^(?:大肥鱼|肥鱼)\s*[，,、]?\s*(?:唱|来)\s*(?:一?首|一个|个)?\s*(.+)$"
    )
    SING_TAIL = re.compile(r"(?:听听|听一下|听|给我听|吧|呗|好吗|好不好|嘛|呀)+[。！!？?~～]*$")

    @filter.event_message_type(filter.EventMessageType.ALL)
    async def natural_language(self, event: AstrMessageEvent):
        """听懂人话：'大肥鱼说 你好' / '唱首雨爱听听'。"""
        raw = (event.message_str or "").strip()
        if not raw or raw.startswith("/") or raw.startswith("#"):
            return

        # ① 先看有没有待确认的点歌
        origin = event.unified_msg_origin
        pending = self.pending_songs.get(origin)
        if pending:
            # 5 分钟没回就作废
            if time.time() - pending["ts"] > 300:
                self.pending_songs.pop(origin, None)
            else:
                low = raw.replace(" ", "")
                if any(w in low for w in self.DENY_WORDS):
                    self.pending_songs.pop(origin, None)
                    yield event.plain_result("好吧，那换一首～")
                    return
                if any(w in low for w in self.CONFIRM_WORDS) and len(low) <= 8:
                    self.pending_songs.pop(origin, None)
                    song = pending["song"]
                    self.sing(event, song)
                    yield event.plain_result("好，我这就唱～")
                    return
                # 没说确认也没否认，就当重新点歌，清掉旧的
                self.pending_songs.pop(origin, None)

        m = self.NATURAL_SPEAK.match(raw)
        if m:
            content = m.group(1).strip()
            if len(content) < 2:
                yield event.plain_result("你还没说想让我说什么呀")
                return
            try:
                yield event.plain_result(
                    await self.enqueue(
                        event,
                        "speech",
                        dict(text=content, style=self.config.get("style", "gentle")),
                    )
                )
            except Exception as exc:
                yield event.plain_result(self._oops(exc))
            return

        s = self.NATURAL_SING.match(raw) or self.NATURAL_BIGSING.match(raw)
        if s:
            song = self.SING_TAIL.sub("", s.group(1)).strip()
            # 只去掉书名号和引号，别碰括号（(feat. xxx) 是歌名的一部分）
            song = song.strip("《》【】\"'「」 ")
            if song and len(song) >= 2:
                self.ask_confirm(event, song)
                yield event.plain_result("等我找找看是哪首～")
            return

    @filter.command("肥鱼换声", alias={"feiyu_rvc"})
    async def conversion(self, event: AstrMessageEvent):
        try:
            audio_id = await self.attached_asset(event, {".wav", ".flac"})
            yield event.plain_result(
                await self.enqueue(event, "conversion", dict(audio_id=audio_id))
            )
        except Exception as exc:
            yield event.plain_result(self._oops(exc))

    @filter.command("肥鱼唱歌", alias={"feiyu_sing"})
    async def singing(self, event: AstrMessageEvent, lyrics: GreedyStr):
        try:
            score_id = await self.attached_asset(event, {".mid", ".midi", ".abc"})
            yield event.plain_result(
                await self.enqueue(
                    event,
                    "singing",
                    dict(score_id=score_id, lyrics=str(lyrics) or None),
                )
            )
        except Exception as exc:
            yield event.plain_result(self._oops(exc))

    @filter.command("肥鱼任务", alias={"feiyu_job"})
    async def job(self, event: AstrMessageEvent, job_id: str):
        try:
            if self.jobs.get(job_id, {}).get("origin") != event.unified_msg_origin:
                raise ValueError("本会话没有这个任务。")
            result = await self.client.status(job_id)
            if result["status"] == "success":
                audio = await self.client.download(job_id, self.directory)
                yield event.chain_result([Comp.Record.fromFileSystem(str(audio))])
            else:
                yield event.plain_result("肥鱼任务状态：" + result["status"])
        except Exception as exc:
            yield event.plain_result(self._oops(exc))

    @filter.llm_tool(name="feiyu_speak")
    async def speak_tool(
        self, event: AstrMessageEvent, text: str, style: str = "cute"
    ) -> str:
        """用肥鱼声音朗读或说话。需要演唱谱子时使用 feiyu_sing；已有音频换声使用 feiyu_convert。

        Args:
            text(string): 要说的文字，最多2000字。
            style(string): cute 或 gentle。
        """
        try:
            return await self.enqueue(event, "speech", dict(text=text, style=style))
        except Exception as exc:
            return str(exc)

    @filter.llm_tool(name="feiyu_convert")
    async def convert_tool(
        self, event: AstrMessageEvent, source: str = "attachment"
    ) -> str:
        """把当前消息所附的清唱或语音转换成肥鱼音色。需要已有音频；不能直接把谱子交给RVC。

        Args:
            source(string): 固定为attachment，表示使用本消息附件，不能填写文件路径或URL。
        """
        try:
            if source != "attachment":
                return "只能使用本消息附件。"
            audio_id = await self.attached_asset(event, {".wav", ".flac"})
            return await self.enqueue(event, "conversion", dict(audio_id=audio_id))
        except Exception as exc:
            return str(exc)

    @filter.llm_tool(name="feiyu_sing")
    async def sing_tool(self, event: AstrMessageEvent, lyrics: str = "") -> str:
        """根据当前消息所附的MIDI或ABC主旋律和中文歌词唱歌，服务自动使用SVS后再调用RVC。一字多音用_占位。

        Args:
            lyrics(string): 按音符顺序排列的歌词；内嵌完整歌词的MIDI可留空。
        """
        try:
            score_id = await self.attached_asset(event, {".mid", ".midi", ".abc"})
            return await self.enqueue(
                event, "singing", dict(score_id=score_id, lyrics=lyrics or None)
            )
        except Exception as exc:
            return str(exc)

    async def terminate(self):
        for task in self.tasks:
            task.cancel()
        await asyncio.gather(*self.tasks, return_exceptions=True)
        await self.client.close()
